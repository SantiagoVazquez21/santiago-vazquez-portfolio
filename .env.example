# Contact form (spec 005). Copy this file to .env.local and fill in the values.
# Server only: never expose them to the browser with a public prefix. In
# Vercel, set them in Project Settings > Environment Variables. Without them
# the site still works and the contact form shows the sending error.

# Resend API key with sending permission.
RESEND_API_KEY=

# Inbox that receives the messages. Must be the email of the Resend account,
# because the onboarding@resend.dev sender only delivers to that address.
CONTACT_TO_EMAIL=
